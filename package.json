{
  "name": "storage-saver",
  "version": "0.12.17",
  "description": "Keeps your computer's storage low. 3D visualiser of where your space goes, plus safe one-click cleanup.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/copy-vendor.js",
    "test": "node --test test/*.test.js",
    "build:demo": "node scripts/build-demo.js",
    "dist": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis --x64 --arm64",
    "dist:mas": "electron-builder --mac mas --universal",
    "dist:mas-dev": "electron-builder --mac mas-dev --arm64"
  },
  "author": "Angus",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "sql.js": "^1.13.0",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "com.sommarfilms.storagesaver",
    "productName": "Gigapolis",
    "files": [
      "src/**/*",
      "package.json",
      "!src/renderer/vendor/*.map"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Gigapolis measures what is on your Desktop so it can show it in the city.",
        "NSDocumentsFolderUsageDescription": "Gigapolis measures your Documents so it can show them in the city.",
        "NSDownloadsFolderUsageDescription": "Gigapolis measures your Downloads so it can show them in the city.",
        "NSRemovableVolumesUsageDescription": "Gigapolis can measure external drives you choose.",
        "NSNetworkVolumesUsageDescription": "Gigapolis can measure network drives you choose.",
        "NSPhotoLibraryUsageDescription": "Gigapolis measures the size of your Photos library.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.utilities",
        "NSHumanReadableCopyright": "Copyright © 2026 Sommarfilms. All rights reserved."
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "angus-byte",
        "repo": "storage-saver",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gigapolis",
      "deleteAppDataOnUninstall": false
    },
    "mas": {
      "type": "distribution",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "extraResources": [
        {
          "from": "build/PrivacyInfo.xcprivacy",
          "to": "PrivacyInfo.xcprivacy"
        }
      ],
      "artifactName": "${productName}-${version}-mas.${ext}"
    },
    "masDev": {
      "type": "development",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded-dev.provisionprofile",
      "extraResources": [
        {
          "from": "build/PrivacyInfo.xcprivacy",
          "to": "PrivacyInfo.xcprivacy"
        }
      ]
    }
  }
}
