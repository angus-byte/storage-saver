{
  "name": "storage-saver",
  "version": "0.2.0",
  "description": "Keeps your computer's storage low. 3D visualiser of where your space goes, plus safe one-click cleanup.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/copy-vendor.js",
    "test": "node --test test/*.test.js",
    "build:demo": "node scripts/build-demo.js",
    "dist": "electron-builder --mac dmg"
  },
  "author": "Angus",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "build": {
    "appId": "com.sommarfilms.storagesaver",
    "productName": "Storage Saver",
    "files": ["src/**/*", "package.json", "!src/renderer/vendor/*.map"],
    "mac": { "category": "public.app-category.utilities", "target": ["dmg"], "icon": "build/icon.png", "artifactName": "${productName}-${version}-${arch}.${ext}" },
    "win": { "target": ["nsis"] }
  }
}
